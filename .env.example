# ==========================================
# DASHBOARD (proteção por senha)
# ==========================================
# Define uma senha para criptografar o summary.json (AES-256-GCM).
# Sem senha = dados públicos. Com senha = dashboard exige login.
# Use uma senha forte (mínimo 12 caracteres, mistura de letras/números/símbolos).
DASHBOARD_PASSWORD=sua_senha_forte_aqui

# ==========================================
# MICROSOFT CLARITY
# ==========================================
# Gerar em clarity.microsoft.com → Settings → Data Export → Generate new API token
# Limites: 10 requests/dia, dados dos últimos 1-3 dias (acumulamos em planilha)
CLARITY_API_TOKEN=seu_jwt_token_aqui

# ==========================================
# SUPABASE (autenticação e armazenamento seguro)
# ==========================================
